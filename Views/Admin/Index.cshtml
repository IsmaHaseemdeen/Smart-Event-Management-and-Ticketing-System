@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Admin Dashboard</h2>
    <span class="text-muted small">Council Admin Panel</span>
</div>

<div class="row g-3 mb-4">

    <div class="col-md-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-muted small">Total Events</div>
                <div class="fs-4 fw-bold">@ViewBag.TotalEvents</div>
                <div class="small text-muted">Active: @ViewBag.ActiveEvents</div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-muted small">Upcoming Sessions</div>
                <div class="fs-4 fw-bold">@ViewBag.UpcomingSessions</div>
                <div class="small text-muted">Only ACTIVE + future</div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-muted small">Total Bookings</div>
                <div class="fs-4 fw-bold">@ViewBag.TotalBookings</div>
                <div class="small text-muted">
                    Confirmed: @ViewBag.ConfirmedBookings
                </div>
            </div>
        </div>
    </div>

</div>

<!-- SECOND ROW -->
<div class="row g-3 mb-4">

    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h5 class="mb-3">Bookings Summary</h5>

                <div class="d-flex justify-content-between border-bottom py-2">
                    <span>Pending</span>
                    <span class="fw-semibold">@ViewBag.PendingBookings</span>
                </div>
                <div class="d-flex justify-content-between border-bottom py-2">
                    <span>Confirmed</span>
                    <span class="fw-semibold">@ViewBag.ConfirmedBookings</span>
                </div>
                <div class="d-flex justify-content-between py-2">
                    <span>Cancelled</span>
                    <span class="fw-semibold">@ViewBag.CancelledBookings</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h5 class="mb-3">Reviews & Inquiries</h5>

                <div class="row g-3">
                    <div class="col-6">
                        <div class="border rounded p-3">
                            <div class="text-muted small">Reviews</div>
                            <div class="fw-bold fs-5">@ViewBag.TotalReviews</div>
                            <div class="small text-muted">Visible: @ViewBag.VisibleReviews | Hidden: @ViewBag.HiddenReviews</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="border rounded p-3">
                            <div class="text-muted small">Inquiries</div>
                            <div class="fw-bold fs-5">@ViewBag.TotalInquiries</div>
                            <div class="small text-muted">
                                New: @ViewBag.NewInquiries | In Progress: @ViewBag.InProgressInquiries
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-3 small text-muted">
                    Resolved inquiries: @ViewBag.ResolvedInquiries
                </div>
            </div>
        </div>
    </div>

</div>

<!-- QUICK LINKS -->
<div class="card shadow-sm">
    <div class="card-body">
        <h5 class="mb-3">Management</h5>

        <div class="list-group">
            <a class="list-group-item list-group-item-action" asp-controller="AdminVenues" asp-action="Index">
                Manage Venues
            </a>
            <a class="list-group-item list-group-item-action" asp-controller="AdminCategories" asp-action="Index">
                Manage Categories
            </a>
            <a class="list-group-item list-group-item-action" asp-controller="AdminEvents" asp-action="Index">
                Manage Events
            </a>
            <a class="list-group-item list-group-item-action" asp-controller="AdminSessions" asp-action="Index">
                Manage Sessions
            </a>
            <a class="list-group-item list-group-item-action" asp-controller="AdminTicketTypes" asp-action="Index">
                Manage Ticket Types
            </a>
        </div>

        <div class="text-muted small mt-3">
        </div>
    </div>
</div>
