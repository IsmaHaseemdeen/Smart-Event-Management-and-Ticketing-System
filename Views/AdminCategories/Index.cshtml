@model List<EventTicketingSystem.Models.Category>
@{
    ViewData["Title"] = "Categories";
}

<h2>Categories</h2>

<a class="btn btn-primary mb-3" asp-action="Create">+ Add Category</a>

@if (Model.Count == 0)
{
    <div class="alert alert-secondary">No categories yet.</div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>@c.CategoryName</td>
                    <td>@c.Description</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@c.CategoryId">Edit</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@c.CategoryId">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
