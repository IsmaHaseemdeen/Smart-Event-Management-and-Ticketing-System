@model EventTicketingSystem.Models.Inquiry

@{
    ViewData["Title"] = "Inquiry Details";
}

<h2 class="mb-3">Inquiry Details</h2>

<div class="card mb-3">
    <div class="card-body">
        <div class="row g-2">
            <div class="col-md-6">
                <div class="text-muted small">From</div>
                <div class="fw-semibold">
                    @(Model.User != null ? Model.User.FullName : "Guest")
                </div>
                <div class="text-muted">
                    @(Model.UserId != null ? "Member" : "Guest")
                    @if (!string.IsNullOrWhiteSpace(Model.Email))
                    {
                        <span> • @Model.Email</span>
                    }
                </div>
            </div>

            <div class="col-md-6">
                <div class="text-muted small">Created</div>
                <div class="fw-semibold">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</div>
            </div>
        </div>

        <hr />

        <div class="row g-2">
            <div class="col-md-6 mb-2">
                <div class="text-muted small">Type</div>
                <div class="fw-semibold">@Model.InquiryType</div>
            </div>

            <div class="col-md-6 mb-2">
                <div class="text-muted small">Status</div>
                <div class="fw-semibold">@Model.Status</div>
            </div>
        </div>

        <div class="mb-2">
            <div class="text-muted small">Subject</div>
            <div class="fw-semibold">@Model.Subject</div>
        </div>

        <div class="mb-2">
            <div class="text-muted small">Message</div>
            <div class="border rounded p-2 bg-light">@Model.Message</div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <h5 class="mb-3">Admin Reply / Status</h5>

        <form asp-action="Update" method="post" id="replyForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="inquiryId" value="@Model.InquiryId" />

            <div class="mb-3">
                <label class="form-label">Status</label>
                <select class="form-select" name="status">
                    <option value="OPEN" selected="@(Model.Status == "OPEN")">OPEN</option>
                    <option value="CLOSED" selected="@(Model.Status == "CLOSED")">CLOSED</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Reply (optional)</label>
                <textarea class="form-control" name="reply" rows="4">@Model.Reply</textarea>
                <div class="form-text">Tip: If you add a reply, consider closing the inquiry.</div>
            </div>

            <button class="btn btn-primary">Save</button>
            <a class="btn btn-outline-secondary ms-2" asp-action="Index">Back</a>
        </form>

        @if (Model.RepliedAt != null)
        {
            <div class="text-muted small mt-3">
                Last replied: @Model.RepliedAt.Value.ToString("yyyy-MM-dd HH:mm")
            </div>
        }
    </div>
</div>

<script>
    // Optional "confirm close"
    (function () {
      const f = document.getElementById("replyForm");
      if (!f) return;

      f.addEventListener("submit", function (e) {
        const status = f.querySelector('select[name="status"]')?.value;
        if (status === "CLOSED") {
          if (!confirm("Mark this inquiry as CLOSED?")) {
            e.preventDefault();
          }
        }
      });
    })();
</script>