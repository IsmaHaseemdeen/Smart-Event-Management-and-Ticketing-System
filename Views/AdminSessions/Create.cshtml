@model EventTicketingSystem.Models.EventSession
@{
    ViewData["Title"] = "Add Session";
}

<h2 class="mb-3">Add Session</h2>

<form asp-action="Create" method="post" class="card p-3 shadow-sm">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label class="form-label">Event</label>
        <select class="form-select" asp-for="EventId" asp-items="ViewBag.EventId"></select>
        <span asp-validation-for="EventId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Start Date &amp; Time</label>
        <input asp-for="StartDatetime" type="datetime-local" class="form-control" />
        <span asp-validation-for="StartDatetime" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">End Date &amp; Time (optional)</label>
        <input asp-for="EndDatetime" type="datetime-local" class="form-control" />
        <span asp-validation-for="EndDatetime" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Total Seats</label>
        <input asp-for="TotalSeats" type="number" min="0" class="form-control" />
        <span asp-validation-for="TotalSeats" class="text-danger"></span>
        <div class="form-text">Total seats for the whole session (shared across ticket types).</div>
    </div>

    <div class="mb-3">
        <label class="form-label">Status</label>
        <select asp-for="SessionStatus" class="form-select">
            <option value="ACTIVE">ACTIVE</option>
            <option value="CANCELLED">CANCELLED</option>
            <option value="FINISHED">FINISHED</option>
        </select>
        <span asp-validation-for="SessionStatus" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Notes (optional)</label>
        <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Notes" class="text-danger"></span>
    </div>

    <input type="hidden" asp-for="ReservedSeats" />
    <input type="hidden" asp-for="SoldSeats" />
    <input type="hidden" asp-for="SessionDate" />

    <button class="btn btn-success" type="submit">Save</button>
    <a class="btn btn-outline-secondary ms-2" asp-action="Index" asp-route-eventId="@Model.EventId">Back</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}