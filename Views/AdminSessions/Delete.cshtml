@model EventTicketingSystem.Models.EventSession
@{
    ViewData["Title"] = "Delete Session";
}

<h2>Delete Session</h2>

<div class="alert alert-warning">Are you sure you want to delete this session?</div>

<div class="card p-3 mb-3">
    <div><b>Event:</b> @Model.Event?.Title</div>
    <div><b>Start:</b> @Model.StartDatetime.ToString("yyyy-MM-dd HH:mm")</div>
    <div><b>Status:</b> @Model.SessionStatus</div>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="SessionId" />
    <button class="btn btn-danger" type="submit">Yes, Delete</button>
    <a class="btn btn-secondary"
       asp-action="Index"
       asp-route-eventId="@Model.EventId">Cancel</a>
</form>
