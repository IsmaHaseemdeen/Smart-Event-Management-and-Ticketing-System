@model List<EventTicketingSystem.Models.EventSession>
@{
    ViewData["Title"] = "Sessions";
    var eventId = (int)ViewBag.EventId;
}

<h2 class="mb-3">Sessions - @ViewBag.EventTitle</h2>

<div class="mb-3 d-flex gap-2 flex-wrap">
    <a class="btn btn-primary" asp-action="Create" asp-route-eventId="@eventId">+ Add Session</a>
    <a class="btn btn-outline-secondary" asp-controller="AdminEvents" asp-action="Index">Back to Events</a>
</div>

@if (Model == null || Model.Count == 0)
{
    <div class="alert alert-secondary">No sessions yet.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Session #</th>
                    <th>Start</th>
                    <th>End</th>
                    <th>Status</th>
                    <th class="text-end"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    var st = (s.SessionStatus ?? "").ToUpperInvariant();

                    <tr>
                        <td>@s.SessionId</td>
                        <td>@s.StartDatetime.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@(s.EndDatetime.HasValue? s.EndDatetime.Value.ToString("yyyy-MM-dd HH:mm") : "-")</td>
                        <td>
                            @if (st == "ACTIVE")
                            {
                                <span class="badge bg-success">ACTIVE</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@st</span>
                            }
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-success"
                               asp-controller="AdminTicketTypes"
                               asp-action="Index"
                               asp-route-sessionId="@s.SessionId">Ticket Types</a>

                            <a class="btn btn-sm btn-outline-primary"
                               asp-action="Edit"
                               asp-route-id="@s.SessionId">Edit</a>

                            <a class="btn btn-sm btn-outline-danger"
                               asp-action="Delete"
                               asp-route-id="@s.SessionId">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}