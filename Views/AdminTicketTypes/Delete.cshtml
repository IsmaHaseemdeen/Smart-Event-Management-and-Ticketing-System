@model EventTicketingSystem.Models.TicketType
@{
    ViewData["Title"] = "Delete Ticket Type";
}

<h2>Delete Ticket Type</h2>

<div class="alert alert-warning">Are you sure you want to delete this ticket type?</div>

<div class="card p-3 mb-3">
    <div><b>Type:</b> @Model.TypeName</div>
    <div><b>Price:</b> @Model.Price.ToString("0.00")</div>
    <div><b>Status:</b> @Model.Status</div>
</div>

<form asp-action="Delete" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="TicketTypeId" />
    <button class="btn btn-danger" type="submit">Yes, Delete</button>
    <a class="btn btn-secondary" asp-action="Index" asp-route-sessionId="@Model.SessionId">Cancel</a>
</form>