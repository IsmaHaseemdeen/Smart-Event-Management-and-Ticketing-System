@model List<EventTicketingSystem.Models.Venue>
@{
    ViewData["Title"] = "Venues";
}

<h2>Venues</h2>

<a class="btn btn-primary mb-3" asp-action="Create">+ Add Venue</a>

@if (Model.Count == 0)
{
    <div class="alert alert-secondary">No venues yet.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Address</th>
                    <th>City</th>
                    <th>Capacity</th>
                    <th>Phone</th>
                    <th class="text-end"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in Model)
                {
                    <tr>
                        <td class="fw-semibold">@v.VenueName</td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(v.AddressLine1))
                            {
                                <div>@v.AddressLine1</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(v.AddressLine2))
                            {
                                <div class="text-muted">@v.AddressLine2</div>
                            }
                            @if (string.IsNullOrWhiteSpace(v.AddressLine1) && string.IsNullOrWhiteSpace(v.AddressLine2))
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>@v.City</td>
                        <td>@(v.Capacity.HasValue? v.Capacity.Value.ToString() : "—")</td>
                        <td>@(string.IsNullOrWhiteSpace(v.Phone) ? "—" : v.Phone)</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@v.VenueId">Edit</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@v.VenueId">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}