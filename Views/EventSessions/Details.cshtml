@model EventTicketingSystem.Models.EventSession

@{
    ViewData["Title"] = "Session Details";
}

<h1>Session Details</h1>

<div>
    <h4>EventSession</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Session ID</dt>
        <dd class="col-sm-10">@Model.SessionId</dd>

        <dt class="col-sm-2">Event ID</dt>
        <dd class="col-sm-10">@Model.EventId</dd>

        <dt class="col-sm-2">Start</dt>
        <dd class="col-sm-10">@Model.StartDatetime</dd>

        <dt class="col-sm-2">End</dt>
        <dd class="col-sm-10">@Model.EndDatetime</dd>

        <dt class="col-sm-2">Status</dt>
        <dd class="col-sm-10">@Model.SessionStatus</dd>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model.SessionId">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
