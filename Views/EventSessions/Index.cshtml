@model IEnumerable<EventTicketingSystem.Models.EventSession>

@{
    ViewData["Title"] = "Sessions";
}

<h1>Sessions</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.First().SessionId)</th>
            <th>@Html.DisplayNameFor(model => model.First().EventId)</th>
            <th>@Html.DisplayNameFor(model => model.First().StartDatetime)</th>
            <th>@Html.DisplayNameFor(model => model.First().EndDatetime)</th>
            <th>@Html.DisplayNameFor(model => model.First().SessionStatus)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.SessionId</td>
                <td>@item.EventId</td>
                <td>@item.StartDatetime</td>
                <td>@item.EndDatetime</td>
                <td>@item.SessionStatus</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.SessionId">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.SessionId">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.SessionId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
