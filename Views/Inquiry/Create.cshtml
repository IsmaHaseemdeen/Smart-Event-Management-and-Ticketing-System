@{
    ViewData["Title"] = "Send Inquiry";
}

<div class="container inquiry-wrap">
    <div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-3">
        <div>
            <h2 class="page-title">Send Inquiry</h2>
            <div class="page-subtitle">Contact the Council team. We usually respond within 1–2 business days.</div>
        </div>
        <span class="badge-soft ivory">Support</span>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <form asp-action="Create" method="post" class="card panel-card">
        @Html.AntiForgeryToken()

        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Inquiry Type</label>
                    <select class="form-select select-pill" name="inquiryType" required>
                        <option value="GENERAL">General</option>
                        <option value="EVENT">Event</option>
                        <option value="MEMBERSHIP">Membership</option>
                        <option value="TECHNICAL">Technical</option>
                    </select>
                </div>

                <div class="col-md-8">
                    <label class="form-label fw-semibold">Email</label>
                    <input class="form-control select-pill"
                           name="email"
                           type="email"
                           required
                           placeholder="you@example.com" />
                </div>

                <div class="col-12">
                    <label class="form-label fw-semibold">Subject</label>
                    <input class="form-control select-pill" name="subject" required placeholder="Brief summary" />
                </div>

                <div class="col-12">
                    <label class="form-label fw-semibold">Message</label>
                    <textarea class="form-control select-pill" name="message" rows="5" required
                              placeholder="Write your message here..."></textarea>
                </div>
            </div>

            <div class="actions-row mt-4">
                <button class="btn btn-primary btn-theme" type="submit">Submit</button>
                <a class="btn btn-outline-secondary btn-theme" asp-controller="Home" asp-action="Index">Back</a>
            </div>
        </div>
    </form>
</div>