@using EventTicketingSystem.Models
@{
    ViewData["Title"] = "My Preferences";

    var categories = ViewBag.Categories as List<Category> ?? new List<Category>();

    var selected = ViewBag.Selected as List<int> ?? new List<int>();

    var levels = ViewBag.Levels as Dictionary<int, int> ?? new Dictionary<int, int>();
}

<h2 class="mb-4">Select Your Preferred Categories</h2>

<form method="post" class="card p-3">
    @if (categories.Count == 0)
    {
        <div class="alert alert-warning mb-0">No categories found.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th style="width:60px;">Select</th>
                        <th>Category</th>
                        <th style="width:220px;">Preference Level</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in categories)
                    {
                        var isChecked = selected.Contains(c.CategoryId);
                        var level = levels.ContainsKey(c.CategoryId) ? levels[c.CategoryId] : 2;

                        <tr>
                            <td>
                                <input class="form-check-input"
                                       type="checkbox"
                                       name="selectedCategories"
                                       value="@c.CategoryId"
                                       @(isChecked ? "checked" : "") />
                            </td>
                            <td>@c.CategoryName</td>
                            <td>
                                <select class="form-select form-select-sm" name="preferenceLevels[@c.CategoryId]">
                                    @for (int i = 0; i <= 5; i++)
                                    {
                                        <option value="@i" selected="@(i == level)">@i</option>
                                    }
                                </select>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="form-text mb-2">
            0=VeryLow, 1=Low, 2=Normal, 3=Medium, 4=High, 5=VeryHigh
        </div>

        <button type="submit" class="btn btn-primary mt-2">Save Preferences</button>
    }
</form>
