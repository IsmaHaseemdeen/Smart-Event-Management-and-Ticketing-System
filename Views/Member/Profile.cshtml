@model EventTicketingSystem.Models.MemberProfile
@using EventTicketingSystem.Models

@{
    ViewData["Title"] = "My Profile";

    var categories = ViewBag.Categories as List<Category> ?? new List<Category>();

    var prefs = Model?.Preferences ?? new List<MemberPreference>();
    var selectedIds = prefs.Select(p => p.CategoryId).ToHashSet();

    int GetLevel(MemberPreference p)
        => int.TryParse(p.PreferenceLevel, out var v) ? v : 2;

    var prefLevelByCat = prefs.ToDictionary(p => p.CategoryId, p => GetLevel(p));
}

<h2 class="mb-3">My Profile</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

@if (Model == null)
{
    <div class="alert alert-danger">Profile not found.</div>
    return;
}

<form asp-action="Profile" method="post" class="card shadow-sm">
    @Html.AntiForgeryToken()

    <div class="card-body">

        <input type="hidden" name="memberProfileId" value="@Model.MemberProfileId" />

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Full Name *</label>
                <input class="form-control" name="fullName" value="@Model.FullName" required />
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Contact Number *</label>
                <input class="form-control" name="contactNumber" value="@Model.ContactNumber" required />
                <div class="form-text">Staff verification uses the last 2 digits of your contact number.</div>
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Date of Birth</label>
                <input class="form-control"
                       type="date"
                       name="dateOfBirth"
                       value="@(Model.DateOfBirth.HasValue? Model.DateOfBirth.Value.ToString("yyyy-MM-dd") : "")" />
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">City *</label>
                <input class="form-control" name="city" value="@Model.City" required />
            </div>

            <div class="col-12 mb-3">
                <label class="form-label">Address</label>
                <input class="form-control" name="address" value="@Model.Address" />
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Status</label>
                <select class="form-select" name="status">
                    <option value="ACTIVE" selected="@(string.Equals(Model.Status, "ACTIVE", StringComparison.OrdinalIgnoreCase))">ACTIVE</option>
                    <option value="INACTIVE" selected="@(string.Equals(Model.Status, "INACTIVE", StringComparison.OrdinalIgnoreCase))">INACTIVE</option>
                </select>
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Created At</label>
                <input class="form-control" value="@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")" disabled />
            </div>
        </div>

        <hr />

        <h5 class="mb-2">My Preferred Categories</h5>
        <div class="text-muted mb-3">
            Select categories and choose a preference level (0–5).
        </div>

        @if (categories.Count == 0)
        {
            <div class="alert alert-warning mb-0">
                No categories found. Seed categories first.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th style="width:60px;">Select</th>
                            <th>Category</th>
                            <th style="width:220px;">Preference Level</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in categories)
                        {
                            var isChecked = selectedIds.Contains(c.CategoryId);
                            var level = prefLevelByCat.ContainsKey(c.CategoryId) ? prefLevelByCat[c.CategoryId] : 2;

                            <tr>
                                <td>
                                    <input class="form-check-input"
                                           type="checkbox"
                                           name="selectedCategoryIds"
                                           value="@c.CategoryId"
                                           @(isChecked ? "checked" : "") />
                                </td>
                                <td>@c.CategoryName</td>
                                <td>
                                    <select class="form-select form-select-sm"
                                            name="preferenceLevels[@c.CategoryId]">
                                        @for (int i = 0; i <= 5; i++)
                                        {
                                            <option value="@i" selected="@(i == level)">@i</option>
                                        }
                                    </select>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="form-text">
                Only selected categories will be saved. Unchecked categories will be removed from your preferences.
            </div>
        }
    </div>

    <div class="card-footer d-flex justify-content-end">
        <button class="btn btn-primary" type="submit">Save</button>
    </div>
</form>