@model EventTicketingSystem.Models.Users

@{
    ViewData["Title"] = "My Profile";
}

<h2 class="mb-3">My Profile</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Err"] != null)
{
    <div class="alert alert-danger">@TempData["Err"]</div>
}

@if (Model == null)
{
    <div class="alert alert-danger">Profile not found.</div>
    return;
}

<form asp-action="Profile" method="post" class="card shadow-sm" id="profileForm">
    @Html.AntiForgeryToken()

    <div class="card-body">
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Full Name *</label>
                <input class="form-control" name="fullName" value="@Model.FullName" required />
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Phone *</label>
                <input class="form-control" name="phone" value="@Model.Phone" required />
                <div class="form-text">Staff verification uses the last 2 digits of your phone number.</div>
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Email</label>
                <input class="form-control" value="@Model.Email" disabled />
                <div class="form-text">Email is used for login.</div>
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Status</label>
                <input class="form-control" value="@Model.Status" disabled />
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Role</label>
                <input class="form-control" value="@Model.Role" disabled />
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Created At</label>
                <input class="form-control" value="@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")" disabled />
            </div>
        </div>
    </div>

    <div class="card-footer d-flex justify-content-end">
        <button class="btn btn-primary" type="submit">Save</button>
    </div>
</form>

<script>

    (function () {
      const f = document.getElementById("profileForm");
      if (!f) return;

      f.addEventListener("submit", function (e) {
        const fullName = f.querySelector('input[name="fullName"]');
        const phone = f.querySelector('input[name="phone"]');

        if (!fullName.value.trim() || !phone.value.trim()) {
          e.preventDefault();
          alert("Please fill all required fields.");
        }
      });
    })();
</script>