@{
    ViewData["Title"] = "Submit Review";
    int eventId = (int)(ViewBag.EventId ?? 0);
}

<h2 class="mb-3">Submit Review</h2>

@if (TempData["Err"] != null)
{
    <div class="alert alert-warning">@TempData["Err"]</div>
}

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<form asp-action="Create" method="post" class="card shadow-sm">
    @Html.AntiForgeryToken()

    <div class="card-body">
        <input type="hidden" name="eventId" value="@eventId" />
        <input type="hidden" id="ratingValue" name="rating" value="5" />

        <div class="mb-2">
            <label class="form-label">Rating</label>
            <div id="stars" style="font-size: 24px; cursor: pointer;">
                <span data-v="1">★</span>
                <span data-v="2">★</span>
                <span data-v="3">★</span>
                <span data-v="4">★</span>
                <span data-v="5">★</span>
            </div>
            <small class="text-muted">Click a star to set rating</small>
        </div>

        <div class="mb-3">
            <label class="form-label">Comment (optional)</label>
            <textarea id="commentBox"
                      name="comment"
                      class="form-control"
                      rows="4"
                      maxlength="1000"></textarea>
            <small class="text-muted"><span id="count">0</span>/1000</small>
        </div>

        <button type="submit" class="btn btn-primary">Submit</button>
        <a class="btn btn-outline-secondary ms-2"
           asp-action="Index"
           asp-route-eventId="@eventId">Back</a>
    </div>
</form>

@section Scripts {
    <script>
        const stars = document.querySelectorAll('#stars span');
        const ratingValue = document.getElementById('ratingValue');

        function paint(v) {
            stars.forEach(s => {
                const sv = parseInt(s.getAttribute('data-v'));
                s.style.opacity = sv <= v ? '1' : '0.3';
            });
        }

        stars.forEach(s => {
            s.addEventListener('click', () => {
                const v = parseInt(s.getAttribute('data-v'));
                ratingValue.value = v;
                paint(v);
            });
        });

        paint(5);

        const box = document.getElementById('commentBox');
        const count = document.getElementById('count');
        box.addEventListener('input', () => {
            count.innerText = box.value.length;
        });
    </script>
}